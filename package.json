{
  "name": "Darube",
  "private": true,
  "version": "1.0.0",
  "description": "a db management tools",
  "author": "ferlinni",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:go": "node scripts/test-go.js"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-code-editor": "^0.14.1",
    "react-split": "^2.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^40.7.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "vite": "^6.1.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.ferlinni.Darube",
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**",
      "main.js",
      "preload.js",
      "scripts/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine/bin",
        "to": "engine/bin",
        "filter": [
          "engine",
          "engine.exe"
        ]
      }
    ]
  }
}
